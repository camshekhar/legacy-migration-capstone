# .env.example — copy to .env and fill in your own credentials.
# Never commit the real .env file.

# --- LLM (Google Gemini, free tier via aistudio.google.com) ---
LLM_API_KEY=your_google_ai_studio_api_key_here
LLM_MODEL=gemini-2.0-flash

# --- Source DB: legacy MySQL ---
SOURCE_DB_URL=mysql+pymysql://legacy_user:legacy_pass@localhost:3306/legacy_db

# --- Target: Snowflake ---
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MIGRATION_TARGET
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# --- LangFuse observability ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Pipeline behavior ---
CONFIDENCE_THRESHOLD=0.80
TABLE_FILTER=all
